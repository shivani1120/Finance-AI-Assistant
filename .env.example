APP_NAME=Finance RAG Assistant
APP_ENV=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

POSTGRES_DB=finance_rag
POSTGRES_USER=finance_rag
POSTGRES_PASSWORD=change-me-for-local-use
DATABASE_URL=postgresql+psycopg://finance_rag:change-me-for-local-use@postgres:5432/finance_rag

# Generate a private random key with: openssl rand -hex 32
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Optional initial administrator. Set both values together; use a strong password.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_URL=http://chroma:8000
CHROMA_COLLECTION=finance_documents
# FastEmbed runs this open model locally without an embeddings API key.
# OpenAI embeddings are also supported.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OPENAI_API_KEY=
GROQ_API_KEY=

# Chat provider and model are selected independently from embeddings.
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b
ANTHROPIC_API_KEY=

# Chunk sizes are character counts. Tune against retrieval evaluation later.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_UPLOAD_SIZE_MB=25
UPLOAD_DIR=/data/uploads
RETRIEVAL_TOP_K=5
RETRIEVAL_MAX_TOP_K=20
